# Ethiopian Financial Intelligence Bureau - Environment Configuration
# Copy this file to .env and update with your actual API keys

# =============================================================================
# LLM Configuration (Choose One)
# =============================================================================

# Option 1: OpenRouter (Recommended - Free Tier Available)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Option 2: OpenAI (Alternative)
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here

# =============================================================================
# Telegram Alerts Configuration
# =============================================================================

# Get bot token from @BotFather in Telegram
# 1. Message @BotFather → /newbot → follow prompts
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstUvWxYz123456

# Get your chat ID by messaging your bot, then visiting:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=8947037161

# =============================================================================
# Database Configuration (Optional - For Production)
# =============================================================================

# Option 1: Neon PostgreSQL (Free Tier - Recommended for Production)
# Sign up at: https://neon.tech
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname

# Option 2: Supabase PostgreSQL (Free Tier)
# Sign up at: https://supabase.com
# DATABASE_URL=postgresql://postgres:password@host:port/postgres

# Option 3: Local SQLite (Default - No configuration needed)
# Leave DATABASE_URL empty to use local SQLite database
# DATABASE_URL=

# =============================================================================
# Optional Configuration
# =============================================================================

# Enable SQLite persistence (default: True)
# Set to False if using PostgreSQL only
USE_SQLITE=True

# Minimum impact level for Telegram alerts (LOW, MEDIUM, HIGH, CRITICAL)
TELEGRAM_MIN_IMPACT=MEDIUM

# LLM Model Selection (optional)
# LLM_MODEL=gpt-4o-mini

# Custom LLM base URL (for Ollama or other providers)
# LLM_BASE_URL=http://localhost:11434/v1